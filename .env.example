# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On AWS these are set as environment variables on the task/instance instead.
DB_URL=jdbc:postgresql://<host>:5432/challenge_platform
DB_USERNAME=challenge_app
DB_PASSWORD=<from AWS Secrets Manager - never commit>

# Any long random string. Must be stable per environment:
# changing it invalidates every existing one-attempt-per-day lock.
IDENTITY_SALT=<random string>

JUDGE_BASE_URL=https://judge.codereport.com
JUDGE_CPU_TIME_LIMIT=1.0
SERVER_PORT=8090
